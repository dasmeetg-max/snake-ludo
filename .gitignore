# ============================================================
# snake_ludo
#
# Tracked: backend source, and the Unity project's Assets/,
# Packages/ and ProjectSettings/. Everything else here is
# generated, downloaded, or machine-local.
# ============================================================

# ============================================================
# Node / backend
# ============================================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# ============================================================
# Unity generated folders
# ============================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Meta files must stay tracked alongside the assets they describe.
# Path is relative to this file, so it has to name the project folder.
!frontend/unity/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# ============================================================
# Unity build output committed to frontend/ root.
#
# Listed by exact path on purpose — a blanket *.dll or *.exe rule
# would also swallow frontend/unity/Assets/Plugins/Newtonsoft.Json.dll,
# which Unity needs in version control.
# ============================================================
frontend/unity.exe
frontend/UnityPlayer.dll
frontend/UnityCrashHandler64.exe
frontend/unity_Data/
frontend/MonoBleedingEdge/

# ============================================================
# ParrelSync clones — regenerated from the main project on demand
# ============================================================
frontend/unity_clone_*/

# ============================================================
# IDE / solution files (Unity regenerates these on open)
# ============================================================
.vs/
.gradle/
.consulo/
ExportedObj/
*.csproj
*.unityproj
*.sln
*.slnx
*.lscache
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# ============================================================
# Packaged builds
# ============================================================
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ============================================================
# OS / editor cruft
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
